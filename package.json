{
  "name": "dsh-read-guard",
  "version": "0.2.0",
  "description": "Deterministic prompt-injection interception for DeepSeek Harness: scans what the agent READS (tool results) at the moment it enters model context",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync": "node scripts/sync-rig-core.mjs",
    "test": "npm run sync && npm run build && node test/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test scripts",
    "coverage": "c8 --exclude \"test/**\" --check-coverage --lines 70 --branches 65 --functions 55 node test/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-injection",
    "ai-agents",
    "security"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "c8": "^12.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/zhengqiuyang/dsh-read-guard#readme",
  "bugs": { "url": "https://github.com/zhengqiuyang/dsh-read-guard/issues" },
  "author": "zhengqiuyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-read-guard.git"
  }
}
